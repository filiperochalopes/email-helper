# --- Banco e broker ---
DATABASE_URL=postgresql+psycopg://emailagent:emailagent@postgres:5432/emailagent
# Valkey (compatível com protocolo redis://)
REDIS_URL=redis://valkey:6379/0

# CLI no HOST (fora do Docker, ex.: `email-agent gmail auth`): exporte estas versões
# apontando para as portas publicadas em 127.0.0.1 e para ./secrets e ./data:
#   DATABASE_URL=postgresql+psycopg://emailagent:emailagent@localhost:5433/emailagent
#   GMAIL_OAUTH_CLIENT_SECRET_FILE=secrets/gmail_client_secret.json
#   GMAIL_TOKEN_STORAGE_PATH=secrets/gmail_tokens
#   ACCOUNTS_FILE=secrets/accounts.yml
#   OLLAMA_BASE_URL=http://localhost:11434
#   SPAM_MODEL_PATH=data/models/spam_model.joblib

# --- Timezone da rotina (Celery Beat) ---
APP_TIMEZONE=America/Bahia

# --- Evolution API (WhatsApp, somente saída no MVP) ---
EVOLUTION_BASE_URL=https://wpp.exemplo.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
# Formato: 55 + DDD + número, somente dígitos. Ex.: 5571999999999
WHATSAPP_SUMMARY_NUMBER=

# --- Gmail OAuth2 ---
# Arquivo client_secret JSON baixado do Google Cloud Console (tipo "Desktop app")
GMAIL_OAUTH_CLIENT_SECRET_FILE=/secrets/gmail_client_secret.json
# Diretório onde os tokens (refresh tokens) de cada conta são salvos
GMAIL_TOKEN_STORAGE_PATH=/secrets/gmail_tokens

# --- LLM local (Ollama roda NATIVO no macOS; containers acessam via host.docker.internal) ---
# Ver docs/MODELOS.md. OLLAMA_MODEL = base (classificação/resumo por e-mail);
# OLLAMA_MODEL_REASONING = tarefas complexas (priorização de P0); vazio = usa o base.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e2b-mlx
OLLAMA_MODEL_REASONING=gemma4:e4b-mlx
LLM_ENABLED=true

# --- Sync / bootstrap ---
DEFAULT_SYNC_SINCE_DAYS=365
DEFAULT_BOOTSTRAP_MAILBOXES=inbox,spam,sent
MAX_EMAIL_TEXT_CHARS=12000

# --- Digest (resumo WhatsApp) ---
# E-mails mais antigos que isto não entram no resumo:
DIGEST_MAX_AGE_DAYS=90
# Idade mínima para um e-mail virar candidato a exclusão (seção 🧹 do digest):
CLEANUP_MIN_AGE_DAYS=90

# --- Modelos estatísticos (sklearn) ---
SPAM_MODEL_PATH=/data/models/spam_model.joblib
# Modelo multiclasse de categoria (todas as labels, não só spam/ham).
CATEGORY_MODEL_PATH=/data/models/category_model.joblib
TRAINING_MIN_EVENTS=20
# Confiança mínima do modelo de categoria para a decisão dispensar a LLM.
CATEGORY_CONFIDENCE_THRESHOLD=0.70

# --- Label Studio (opcional; sync automático via API na manutenção noturna) ---
# Com URL + API_KEY o agente cria/usa um projeto, empurra os e-mails que precisam
# de revisão (pré-anotados) e puxa as anotações de volta como eventos de treino.
# Nome do serviço na network "ai" é host-label-studio (não label-studio).
LABEL_STUDIO_URL=http://host-label-studio:8080
# Pegue em: Label Studio -> Account & Settings -> Access Token (Legacy Token).
LABEL_STUDIO_API_KEY=
# Opcionais: 0 = resolve/cria o projeto pelo título; ajuste o sample/threshold se quiser.
LABEL_STUDIO_PROJECT_ID=0
LABEL_STUDIO_PROJECT_TITLE=email-agent
LABEL_STUDIO_LOW_CONFIDENCE=0.6
LABEL_STUDIO_PRIORITY_SAMPLE=10

# --- Observabilidade LLM (Langfuse; infra compartilhada em ../infra/langfuse) ---
# Containers usam o nome de serviço interno; no host use https://langfuse.localhost:8443
LANGFUSE_BASE_URL=http://host-langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

LOG_LEVEL=INFO
